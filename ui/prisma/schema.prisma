generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StationCategory {
  BUS_STATION
  BUS_STOP
}

enum LineDirectionMode {
  SINGLE
  BOTH
}

enum LineDirection {
  OUTBOUND
  RETURN
}

enum RideType {
  RECURRING
  ONE_TIME
}

enum RideStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RideExceptionType {
  SKIP
  ADDITIONAL
}

enum PassengerType {
  CHILD
  ADULT
  STUDENT
  PENSIONER
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  VOID
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  authSessions  AuthSession[]
  stations      Station[]
  lines         Line[]
  linePairs     LinePair[]
  lineStops     LineStop[]
  rides         Ride[]
  rideDayTimes  RideDayTime[]
  rideExceptions RideException[]
  rideInstances RideInstance[]
  passengers    Passenger[]
  reservations  Reservation[]

  @@index([isActive])
}

model User {
  id               String   @id @default(cuid())
  tenantId         String
  username         String
  email            String?
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  profileImageUrl  String?
  role             UserRole @default(STAFF)
  passwordHash     String
  refreshTokenHash String?
  lastLoginAt      DateTime?
  isActive         Boolean  @default(true)
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  sessions AuthSession[]

  createdStations      Station[]      @relation("StationCreatedBy")
  updatedStations      Station[]      @relation("StationUpdatedBy")
  createdLines         Line[]         @relation("LineCreatedBy")
  updatedLines         Line[]         @relation("LineUpdatedBy")
  createdLinePairs     LinePair[]     @relation("LinePairCreatedBy")
  updatedLinePairs     LinePair[]     @relation("LinePairUpdatedBy")
  createdLineStops     LineStop[]     @relation("LineStopCreatedBy")
  updatedLineStops     LineStop[]     @relation("LineStopUpdatedBy")
  createdRides         Ride[]         @relation("RideCreatedBy")
  updatedRides         Ride[]         @relation("RideUpdatedBy")
  createdRideDayTimes  RideDayTime[]  @relation("RideDayTimeCreatedBy")
  updatedRideDayTimes  RideDayTime[]  @relation("RideDayTimeUpdatedBy")
  createdRideExceptions RideException[] @relation("RideExceptionCreatedBy")
  updatedRideExceptions RideException[] @relation("RideExceptionUpdatedBy")
  createdRideInstances RideInstance[] @relation("RideInstanceCreatedBy")
  updatedRideInstances RideInstance[] @relation("RideInstanceUpdatedBy")
  createdPassengers    Passenger[]    @relation("PassengerCreatedBy")
  updatedPassengers    Passenger[]    @relation("PassengerUpdatedBy")
  createdReservations  Reservation[]  @relation("ReservationCreatedBy")
  updatedReservations  Reservation[]  @relation("ReservationUpdatedBy")

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([createdById])
  @@index([updatedById])
}

model AuthSession {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String
  accessToken           String   @unique
  refreshToken          String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  userAgent             String?
  ipAddress             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@index([refreshTokenExpiresAt])
  @@index([revokedAt])
}

model Station {
  id           String          @id @default(cuid())
  tenantId     String
  name         String
  address      String
  category     StationCategory?
  contactPhone String?
  notes        String?
  isActive     Boolean         @default(true)
  createdById  String?
  updatedById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  departureLines Line[] @relation("LineDepartureStation")
  arrivalLines   Line[] @relation("LineArrivalStation")

  stopLines       LineStop[]     @relation("LineStopStation")
  reservationFrom Reservation[]  @relation("ReservationDepartureStation")
  reservationTo   Reservation[]  @relation("ReservationArrivalStation")

  createdBy User? @relation("StationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("StationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([name])
  @@index([createdById])
  @@index([updatedById])
}

model Line {
  id                 String            @id @default(cuid())
  tenantId           String
  name               String
  departureStationId String
  arrivalStationId   String
  directionMode      LineDirectionMode @default(BOTH)
  direction          LineDirection     @default(OUTBOUND)
  pairKey            String?
  distanceKm         Float?
  durationMinutes    Int?
  basePrice          Decimal?          @db.Decimal(10, 2)
  isActive           Boolean           @default(true)
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  departureStation Station @relation("LineDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation   Station @relation("LineArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)

  stops            LineStop[]
  rides            Ride[]

  pairAsPrimary    LinePair? @relation("LinePairPrimary")
  pairAsSecondary  LinePair? @relation("LinePairSecondary")

  createdBy User? @relation("LineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("LineUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([departureStationId])
  @@index([arrivalStationId])
  @@index([pairKey])
  @@index([isActive])
  @@index([createdById])
  @@index([updatedById])
}

model LinePair {
  id              String   @id @default(cuid())
  tenantId        String
  primaryLineId   String   @unique
  secondaryLineId String   @unique
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())

  primaryLine   Line @relation("LinePairPrimary", fields: [primaryLineId], references: [id], onDelete: Cascade)
  secondaryLine Line @relation("LinePairSecondary", fields: [secondaryLineId], references: [id], onDelete: Cascade)
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  createdBy User? @relation("LinePairCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("LinePairUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdById])
  @@index([updatedById])
}

model LineStop {
  id                    String  @id @default(cuid())
  tenantId              String
  lineId                String
  stationId             String
  orderIndex            Int
  distanceFromStartKm   Float?
  estimatedTimeFromStartMinutes Int?
  createdById           String?
  updatedById           String?

  line      Line   @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station   Station @relation("LineStopStation", fields: [stationId], references: [id], onDelete: Restrict)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("LineStopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("LineStopUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@unique([lineId, orderIndex])
  @@unique([lineId, stationId])
  @@index([stationId])
  @@index([createdById])
  @@index([updatedById])
}

model Ride {
  id                  String     @id @default(cuid())
  tenantId            String
  lineId              String
  name                String
  busCapacity         Int        @default(38)
  type                RideType
  status              RideStatus @default(SCHEDULED)

  startDate           DateTime?
  endDate             DateTime?
  oneTimeDate         DateTime?

  departureTimeLegacy String?
  arrivalTimeLegacy   String?

  createdById         String?
  updatedById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  line       Line            @relation(fields: [lineId], references: [id], onDelete: Restrict)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dayTimes   RideDayTime[]
  exceptions RideException[]
  instances  RideInstance[]
  createdBy  User?           @relation("RideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?           @relation("RideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([lineId])
  @@index([status])
  @@index([type])
  @@index([createdById])
  @@index([updatedById])
}

model RideDayTime {
  id            String @id @default(cuid())
  tenantId      String
  rideId        String
  dayOfWeek     Int
  departureTime String
  arrivalTime   String
  createdById   String?
  updatedById   String?

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("RideDayTimeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("RideDayTimeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@unique([rideId, dayOfWeek])
  @@index([createdById])
  @@index([updatedById])
}

model RideException {
  id            String            @id @default(cuid())
  tenantId      String
  rideId        String
  serviceDate   DateTime
  type          RideExceptionType
  departureTime String?
  arrivalTime   String?
  createdById   String?
  updatedById   String?

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("RideExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("RideExceptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([rideId, serviceDate])
  @@unique([rideId, serviceDate, type])
  @@index([createdById])
  @@index([updatedById])
}

model RideInstance {
  id            String     @id @default(cuid())
  tenantId      String
  rideId        String
  serviceDate   DateTime
  departureTime String
  arrivalTime   String
  status        RideStatus @default(SCHEDULED)
  seatCapacity  Int
  createdById   String?
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  ride         Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  createdBy    User?         @relation("RideInstanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("RideInstanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([serviceDate])
  @@index([status])
  @@unique([rideId, serviceDate, departureTime])
  @@index([createdById])
  @@index([updatedById])
}

model Passenger {
  id            String        @id @default(cuid())
  tenantId      String
  firstName     String
  lastName      String
  phone         String
  email         String?
  idCardNumber  String?
  passengerType PassengerType
  dateOfBirth   DateTime?
  address       String?
  notes         String?
  isActive      Boolean       @default(true)
  createdById   String?
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reservations Reservation[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("PassengerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("PassengerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([createdById])
  @@index([updatedById])
}

model Reservation {
  id                   String            @id @default(cuid())
  tenantId             String
  rideInstanceId       String
  passengerId          String
  seatNumber           Int
  departureStationId   String
  arrivalStationId     String
  status               ReservationStatus @default(ACTIVE)

  basePrice            Decimal?          @db.Decimal(10, 2)
  discountAmount       Decimal?          @db.Decimal(10, 2)
  finalPrice           Decimal?          @db.Decimal(10, 2)
  paymentStatus        PaymentStatus?

  linkedReservationId  String?           @unique
  createdById          String?
  updatedById          String?
  cancelledAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  rideInstance       RideInstance @relation(fields: [rideInstanceId], references: [id], onDelete: Cascade)
  passenger          Passenger    @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  departureStation   Station      @relation("ReservationDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station      @relation("ReservationArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)

  linkedReservation      Reservation? @relation("ReservationLink", fields: [linkedReservationId], references: [id], onDelete: SetNull)
  reverseLinkedReservation Reservation? @relation("ReservationLink")
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy             User?         @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy             User?         @relation("ReservationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([rideInstanceId, status])
  @@index([passengerId])
  @@index([departureStationId, arrivalStationId])
  @@index([seatNumber])
  @@index([createdById])
  @@index([updatedById])
}
