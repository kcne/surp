        {
          "name": "Login - Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Slug",
                "value": "{{tenantSlug}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginIdentifier}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response has access token and user', function () {",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.expect(body).to.have.property('refreshToken');",
                  "  pm.expect(body).to.have.property('user');",
                  "});",
                  "",
                  "if (body.accessToken) {",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "}",
                  "if (body.refreshToken) {",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "}",
                  "if (body.user && body.user.id) {",
                  "  pm.environment.set('currentUserId', body.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
