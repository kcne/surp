    {
      "name": "Health - Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/readiness",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "readiness"
          ]
        }
      },
      "response": []
    }
  ],
