NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/airtable_demo?schema=public
JWT_ACCESS_TOKEN_SECRET=replace-with-long-random-string
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
AWS_ENDPOINT_URL=https://example-bucket-endpoint
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET_NAME=surp-ticket-images
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
TICKETS_MAX_IMAGE_BYTES=5242880
TICKETS_UPLOAD_URL_TTL_SECONDS=600
TICKETS_DOWNLOAD_URL_TTL_SECONDS=600
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM="SURP <contact@surp.rs>"
EMAIL_TIMEOUT_MS=10000
MARKETING_EMAIL_LOGO_URL=https://surp.rs/logo.jpg
MARKETING_LEADS_EMAIL_TO=demo@your-domain.com
