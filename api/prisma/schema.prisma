generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum StationCategory {
  BUS_STATION
  BUS_STOP
}

enum LineDirectionMode {
  SINGLE
  BOTH
}

enum LineDirection {
  OUTBOUND
  RETURN
}

enum PassengerType {
  ADULT
  CHILD
  STUDENT
  SENIOR
}

enum RideType {
  RECURRING
  ONE_TIME
}

enum RideStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RideExceptionType {
  SKIP
  ADDITIONAL
}

model HealthCheckLog {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

model Tenant {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  refreshSessions RefreshSession[]
  stations        Station[]
  lines           Line[]
  lineStops       LineStop[]
  passengers      Passenger[]
  rides           Ride[]
  rideDayTimes    RideDayTime[]
  rideExceptions  RideException[]
  reservations    Reservation[]
}

model User {
  id              String           @id @default(cuid())
  tenantId        String
  createdById     String?
  updatedById     String?
  username        String
  email           String
  passwordHash    String
  role            UserRole         @default(STAFF)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([updatedById])
}

model RefreshSession {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  createdById      String?
  updatedById      String?
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([updatedById])
}

model Station {
  id           String           @id @default(cuid())
  tenantId     String
  createdById  String?
  updatedById  String?
  name         String
  address      String
  category     StationCategory?
  contactPhone String?
  notes        String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureFor Line[]           @relation("LineDepartureStation")
  arrivalFor   Line[]           @relation("LineArrivalStation")
  intermediateFor LineStop[]
  departureForReservation Reservation[] @relation("ReservationDepartureStation")
  arrivalForReservation   Reservation[] @relation("ReservationArrivalStation")

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([updatedById])
}

model Line {
  id                 String   @id @default(cuid())
  tenantId           String
  createdById        String?
  updatedById        String?
  name               String
  departureStationId String
  arrivalStationId   String
  directionMode      LineDirectionMode @default(BOTH)
  direction          LineDirection @default(OUTBOUND)
  pairKey            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureStation   Station  @relation("LineDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station  @relation("LineArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)
  intermediateStops  LineStop[]
  rides              Ride[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([departureStationId])
  @@index([arrivalStationId])
  @@index([pairKey])
  @@index([updatedById])
}

model LineStop {
  id          String   @id @default(cuid())
  tenantId    String
  lineId      String
  stationId   String
  orderIndex  Int
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([lineId, orderIndex])
  @@unique([lineId, stationId])
  @@index([tenantId])
  @@index([lineId])
  @@index([stationId])
  @@index([updatedById])
}

model Reservation {
  id                 String   @id @default(cuid())
  tenantId           String
  departureStationId String
  arrivalStationId   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureStation   Station  @relation("ReservationDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station  @relation("ReservationArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([departureStationId])
  @@index([arrivalStationId])
}

model Passenger {
  id            String        @id @default(cuid())
  tenantId      String
  createdById   String?
  updatedById   String?
  firstName     String
  lastName      String
  phone         String
  email         String?
  passengerType PassengerType @default(ADULT)
  isActive      Boolean       @default(true)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, firstName])
  @@index([tenantId, lastName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([updatedById])
}

model Ride {
  id                  String          @id @default(cuid())
  tenantId            String
  lineId              String
  createdById         String?
  updatedById         String?
  name                String
  capacity            Int
  type                RideType
  status              RideStatus      @default(DRAFT)
  recurringStartDate  DateTime?       @db.Date
  recurringEndDate    DateTime?       @db.Date
  oneTimeDate         DateTime?       @db.Date
  oneTimeDepartureTime String?
  oneTimeArrivalTime  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line                Line            @relation(fields: [lineId], references: [id], onDelete: Restrict)
  dayTimes            RideDayTime[]
  exceptions          RideException[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([lineId])
  @@index([updatedById])
}

model RideDayTime {
  id            String   @id @default(cuid())
  tenantId      String
  rideId        String
  dayOfWeek     Int
  departureTime String
  arrivalTime   String
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ride          Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, dayOfWeek])
  @@index([tenantId])
  @@index([rideId])
  @@index([updatedById])
}

model RideException {
  id            String            @id @default(cuid())
  tenantId      String
  rideId        String
  exceptionDate DateTime          @db.Date
  type          RideExceptionType
  departureTime String?
  arrivalTime   String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ride          Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rideId])
  @@index([rideId, exceptionDate])
  @@index([updatedById])
}
