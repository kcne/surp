generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  STAFF
}

enum StationCategory {
  BUS_STATION
  BUS_STOP
}

enum LineDirectionMode {
  SINGLE
  BOTH
}

enum LineDirection {
  OUTBOUND
  RETURN
}

enum PassengerType {
  ADULT
  CHILD
  STUDENT
  SENIOR
}

enum RideType {
  RECURRING
  ONE_TIME
}

enum RideStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RideExceptionType {
  SKIP
  ADDITIONAL
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum AuditEventType {
  PASSWORD_RESET_ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BUG
  IDEA
  FEATURE
  QUESTION
  OTHER
}

enum StorefrontStatus {
  DRAFT
  PUBLISHED
}

model HealthCheckLog {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

model Tenant {
  id                          String                       @id @default(cuid())
  slug                        String                       @unique
  name                        String
  timezone                    String?
  isActive                    Boolean                      @default(true)
  deactivatedAt               DateTime?
  deactivatedById             String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  users                       User[]
  refreshSessions             RefreshSession[]
  stations                    Station[]
  lines                       Line[]
  lineStops                   LineStop[]
  passengers                  Passenger[]
  rides                       Ride[]
  rideDaySchedules            RideDaySchedule[]
  rideDayScheduleStationTimes RideDayScheduleStationTime[]
  rideExceptions              RideException[]
  reservations                Reservation[]
  auditEvents                 AuditEvent[]
  tickets                     Ticket[]
  ticketComments              TicketComment[]
  ticketAttachments           TicketAttachment[]
  storefront                  AgencyStorefront?

  @@index([isActive])
}

model AgencyStorefront {
  tenantId           String           @id
  status             StorefrontStatus @default(DRAFT)
  publishedAt        DateTime?
  heroTitle          String?
  heroSubtitle       String?
  heroImageUrl       String?
  heroImageAlt       String?
  aboutMarkdown      String?          @db.Text
  footerText         String?
  logoUrl            String?
  logoAlt            String?
  rideIconUrl        String?
  rideIconStorageKey String?
  primaryColor       String?
  sectionsEnabled    Json             @default("{\"hero\":true,\"rides\":true,\"about\":true}")
  seoTitle           String?
  seoDescription     String?
  ogImageUrl         String?
  facebookUrl        String?
  instagramUrl       String?
  twitterUrl         String?
  linkedinUrl        String?
  websiteUrl         String?
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String             @id @default(cuid())
  tenantId    String
  createdById String?
  updatedById String?
  title       String
  description String
  status      TicketStatus       @default(OPEN)
  category    TicketCategory     @default(QUESTION)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  comments    TicketComment[]
  attachments TicketAttachment[]

  @@index([tenantId])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, category, updatedAt])
  @@index([tenantId, createdAt])
  @@index([updatedById])
}

model TicketComment {
  id           String             @id @default(cuid())
  tenantId     String
  ticketId     String
  authorUserId String
  content      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments  TicketAttachment[]

  @@index([tenantId])
  @@index([ticketId])
  @@index([tenantId, ticketId, createdAt])
  @@index([authorUserId])
}

model TicketAttachment {
  id          String         @id @default(cuid())
  tenantId    String
  ticketId    String
  commentId   String?
  createdById String?
  updatedById String?
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ticketId])
  @@index([commentId])
  @@index([tenantId, ticketId, createdAt])
  @@index([updatedById])
}

model User {
  id                    String           @id @default(cuid())
  tenantId              String
  createdById           String?
  updatedById           String?
  username              String
  email                 String
  passwordHash          String
  requirePasswordChange Boolean          @default(false)
  role                  UserRole         @default(STAFF)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshSessions       RefreshSession[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([updatedById])
}

model RefreshSession {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  createdById      String?
  updatedById      String?
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([updatedById])
}

model Station {
  id                          String                       @id @default(cuid())
  tenantId                    String
  createdById                 String?
  updatedById                 String?
  name                        String
  address                     String
  category                    StationCategory?
  contactPhone                String?
  notes                       String?
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureFor                Line[]                       @relation("LineDepartureStation")
  arrivalFor                  Line[]                       @relation("LineArrivalStation")
  intermediateFor             LineStop[]
  rideDayScheduleStationTimes RideDayScheduleStationTime[]
  departureForReservation     Reservation[]                @relation("ReservationDepartureStation")
  arrivalForReservation       Reservation[]                @relation("ReservationArrivalStation")

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([updatedById])
}

model Line {
  id                 String            @id @default(cuid())
  tenantId           String
  createdById        String?
  updatedById        String?
  name               String
  departureStationId String
  arrivalStationId   String
  directionMode      LineDirectionMode @default(BOTH)
  direction          LineDirection     @default(OUTBOUND)
  pairKey            String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureStation   Station           @relation("LineDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station           @relation("LineArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)
  intermediateStops  LineStop[]
  rides              Ride[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([departureStationId])
  @@index([arrivalStationId])
  @@index([pairKey])
  @@index([updatedById])
}

model LineStop {
  id          String   @id @default(cuid())
  tenantId    String
  lineId      String
  stationId   String
  orderIndex  Int
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([lineId, orderIndex])
  @@unique([lineId, stationId])
  @@index([tenantId])
  @@index([lineId])
  @@index([stationId])
  @@index([updatedById])
}

model Reservation {
  id                 String            @id @default(cuid())
  tenantId           String
  rideId             String
  passengerId        String
  createdById        String?
  updatedById        String?
  travelDate         DateTime          @db.Date
  rideDepartureTime  String
  rideArrivalTime    String
  seatNumber         Int
  status             ReservationStatus @default(ACTIVE)
  cancelledAt        DateTime?
  departureStationId String
  arrivalStationId   String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ride               Ride              @relation(fields: [rideId], references: [id], onDelete: Restrict)
  passenger          Passenger         @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  departureStation   Station           @relation("ReservationDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station           @relation("ReservationArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([rideId])
  @@index([passengerId])
  @@index([tenantId, rideId, travelDate])
  @@index([tenantId, rideId, travelDate, rideDepartureTime])
  @@index([tenantId, rideId, travelDate, rideDepartureTime, seatNumber, status])
  @@index([departureStationId])
  @@index([arrivalStationId])
  @@index([updatedById])
}

model Passenger {
  id            String        @id @default(cuid())
  tenantId      String
  createdById   String?
  updatedById   String?
  firstName     String
  lastName      String
  phone         String
  email         String?
  passengerType PassengerType @default(ADULT)
  isActive      Boolean       @default(true)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservations  Reservation[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, firstName])
  @@index([tenantId, lastName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([updatedById])
}

model Ride {
  id                   String            @id @default(cuid())
  tenantId             String
  lineId               String
  createdById          String?
  updatedById          String?
  name                 String
  capacity             Int
  type                 RideType
  status               RideStatus        @default(DRAFT)
  recurringStartDate   DateTime?         @db.Date
  recurringEndDate     DateTime?         @db.Date
  oneTimeDate          DateTime?         @db.Date
  oneTimeDepartureTime String?
  oneTimeArrivalTime   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line                 Line              @relation(fields: [lineId], references: [id], onDelete: Restrict)
  daySchedules         RideDaySchedule[]
  exceptions           RideException[]
  reservations         Reservation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([lineId])
  @@index([updatedById])
}

model RideDaySchedule {
  id           String                       @id @default(cuid())
  tenantId     String
  rideId       String
  dayOfWeek    Int
  createdById  String?
  updatedById  String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ride         Ride                         @relation(fields: [rideId], references: [id], onDelete: Cascade)
  stationTimes RideDayScheduleStationTime[]

  @@unique([rideId, dayOfWeek])
  @@index([tenantId])
  @@index([rideId])
  @@index([updatedById])
}

model RideDayScheduleStationTime {
  id                String          @id @default(cuid())
  tenantId          String
  rideDayScheduleId String
  stationId         String
  orderIndex        Int
  time              String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rideDaySchedule   RideDaySchedule @relation(fields: [rideDayScheduleId], references: [id], onDelete: Cascade)
  station           Station         @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([rideDayScheduleId, stationId])
  @@unique([rideDayScheduleId, orderIndex])
  @@index([tenantId])
  @@index([rideDayScheduleId])
  @@index([stationId])
  @@index([updatedById])
}

model RideException {
  id            String            @id @default(cuid())
  tenantId      String
  rideId        String
  exceptionDate DateTime          @db.Date
  type          RideExceptionType
  departureTime String?
  arrivalTime   String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ride          Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rideId])
  @@index([rideId, exceptionDate])
  @@index([updatedById])
}

model AuditEvent {
  id           String         @id @default(cuid())
  tenantId     String
  actorUserId  String
  targetUserId String?
  type         AuditEventType
  metadata     Json?
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, type])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
}
