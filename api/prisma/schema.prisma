generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum StationCategory {
  BUS_STATION
  BUS_STOP
}

enum LineDirectionMode {
  SINGLE
  BOTH
}

enum LineDirection {
  OUTBOUND
  RETURN
}

model HealthCheckLog {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

model Tenant {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  refreshSessions RefreshSession[]
  stations        Station[]
  lines           Line[]
  lineStops       LineStop[]
  reservations    Reservation[]
}

model User {
  id              String           @id @default(cuid())
  tenantId        String
  createdById     String?
  updatedById     String?
  username        String
  email           String
  passwordHash    String
  role            UserRole         @default(STAFF)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([updatedById])
}

model RefreshSession {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  createdById      String?
  updatedById      String?
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([updatedById])
}

model Station {
  id           String           @id @default(cuid())
  tenantId     String
  createdById  String?
  updatedById  String?
  name         String
  address      String
  category     StationCategory?
  contactPhone String?
  notes        String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureFor Line[]           @relation("LineDepartureStation")
  arrivalFor   Line[]           @relation("LineArrivalStation")
  intermediateFor LineStop[]
  departureForReservation Reservation[] @relation("ReservationDepartureStation")
  arrivalForReservation   Reservation[] @relation("ReservationArrivalStation")

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([updatedById])
}

model Line {
  id                 String   @id @default(cuid())
  tenantId           String
  createdById        String?
  updatedById        String?
  name               String
  departureStationId String
  arrivalStationId   String
  directionMode      LineDirectionMode @default(BOTH)
  direction          LineDirection @default(OUTBOUND)
  pairKey            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureStation   Station  @relation("LineDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station  @relation("LineArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)
  intermediateStops  LineStop[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([departureStationId])
  @@index([arrivalStationId])
  @@index([pairKey])
  @@index([updatedById])
}

model LineStop {
  id          String   @id @default(cuid())
  tenantId    String
  lineId      String
  stationId   String
  orderIndex  Int
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([lineId, orderIndex])
  @@unique([lineId, stationId])
  @@index([tenantId])
  @@index([lineId])
  @@index([stationId])
  @@index([updatedById])
}

model Reservation {
  id                 String   @id @default(cuid())
  tenantId           String
  departureStationId String
  arrivalStationId   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departureStation   Station  @relation("ReservationDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation     Station  @relation("ReservationArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([departureStationId])
  @@index([arrivalStationId])
}
