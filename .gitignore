# Monorepo ignore rules (ui + api)

# Dependencies / package manager
**/node_modules/
/.pnp
.pnp.js

# Environment files
**/.env
**/.env.*
!**/.env.example

# Build outputs
**/dist/
**/build/
**/.next/
**/out/
**/coverage/
**/.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Framework / deployment
**/.vercel/

# TypeScript
**/*.tsbuildinfo

# OS / editor
.DS_Store
*.pem










